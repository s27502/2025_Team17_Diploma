  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1399270716}
  lines:
  - You have died
  - You see darkness
  - But then you see pyramids
  - You're in ancient Egypt
  - Someone is calling your name
  - Then Anubis God of the Funerals appears before you
  - The scales are not in your favour but then he speaks
  - 'Anubis: The truth is harsh, but if you admit to your mistakes I will give you
    one more chance.'
  - 'Anubis: You will face four trials that will determine your fate.'
  - 'Anubis: If you succeed you will find yourself in the Field of Reeds but if you
    fail you will go to the underworld.'
  - 'Anubis: Don''t waste your last chance.'
  textSpeed: 0.1
  _openingMusic: {fileID: 8300000, guid: 02cb6746a00c0e649ad498533e3fb109, type: 3}
  _transition: {fileID: 995820222}
  _imageObject: {fileID: 526765508}
